def get_storage_chat_id():
    if os.path.exists(STORAGE_FILE):
        try:
            with open(STORAGE_FILE, "r") as f:
                return int(f.read().strip())
        except Exception:
            pass
    return None


def save_storage_chat_id(chat_id):
    try:
        with open(STORAGE_FILE, "w") as f:
            f.write(str(chat_id))
    except Exception:
        pass


